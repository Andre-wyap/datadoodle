---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LeadForm from "../components/LeadForm.astro";
import PixelField from "../components/PixelField.astro";

// Marquee. Each group repeats enough times to outrun the widest viewport, then
// the whole group is duplicated once so translateX(-50%) loops seamlessly.
const disciplines = ["CHATGPT", "GEMINI", "PERPLEXITY", "CLAUDE"];
const promises = ["BE FOUND", "BE UNDERSTOOD", "BE RECOMMENDED"];
const repeat = <T,>(items: T[], times: number) => Array.from({ length: times }, () => items).flat();

const pillars: [string, string][] = [
  [
    "Easy to find",
    "Your visibility mapped across Google, ChatGPT, Perplexity and AI Overviews — against named competitors. Schema and entity setup so machines know who you are. Built to be cited, not just crawled.",
  ],
  [
    "Easy to trust",
    "Case studies with real numbers. Your team's actual faces. Licences and credentials where buyers look for them. Live Google reviews. A pricing signal, because silence on price loses more deals than a high price ever will.",
  ],
  [
    "Easy to contact",
    "WhatsApp-first, one tap, pre-filled message. Maximum three form fields. A response-time promise you can keep. Every lead tagged by the page it came from.",
  ],
];

const proofPoints: [string, string, string][] = [
  ["Singapore Funeral Group", "Perplexity", "Named and cited with their own pricing, above every other result."],
  ["Ang Brothers Funeral Services", "Google AI Overview", "Named first among trusted options, real hotline quoted back to the reader."],
  ["Four Solutions", "Google AI Overview", "Named #1 for mould removal in Singapore, cited by domain."],
];
---

<BaseLayout
  title="DataDoodles — Become the business AI recommends"
  description="We measure how ChatGPT, Google AI Overview, Gemini and Perplexity see your business, and improve your chance of being the recommended answer. Typical timeline: 30 days."
>
  <SiteHeader />

  <main>
    <section class="hero" id="visibility-check" aria-labelledby="hero-title">
      <PixelField />
      <div class="shell">
        <div class="hero-grid">
          <div>
            <p class="hero-kicker">Let Your Website Be Seen by AI</p>
            <h1 id="hero-title">Become the business <span class="hl">AI recommends</span>.</h1>
            <p class="hero-subhead">Live in 30 days.</p>
            <p class="hero-sub">
              Your customers are asking ChatGPT, Gemini, Perplexity and Google's AI Overview who to choose. We
              structure your website so the answer is you.
            </p>
          </div>

          <div class="hero-exhibit">
            <p class="exhibit-label">Get your quote</p>
            <div class="panel">
              <span class="panel-label">Work With Us</span>
              <LeadForm source="home" />
            </div>
          </div>
        </div>
      </div>

      <!-- Hero marquee — full-bleed, dark ------------------------------------ -->
      <div class="marquee marquee--dark" aria-hidden="true">
        <div class="marquee-row marquee-row--lead">
          <div class="marquee-track" style="--speed:96s">
            {
              [0, 1].map(() => (
                <div class="marquee-group">
                  {repeat(disciplines, 3).map((word) => (
                    <span class="marquee-word">{word}</span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>

        <div class="marquee-row marquee-row--sub">
          <div class="marquee-track marquee-track--reverse" style="--speed:72s">
            {
              [0, 1].map(() => (
                <div class="marquee-group">
                  {repeat(promises, 8).map((phrase) => (
                    <span class="marquee-word">{phrase}</span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="pillars-title">
      <div class="shell">
        <div class="section-head section-head--wide">
          <p class="eyebrow"><span>What we build</span></p>
          <h2 id="pillars-title">Easy to find. Easy to trust. Easy to contact.</h2>
        </div>

        <div class="col-grid pillar-grid">
          {
            pillars.map(([title, copy]) => (
              <article class="col pillar">
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section proof-teaser" aria-labelledby="proof-title">
      <div class="shell">
        <div class="section-head">
          <p class="eyebrow"><span>What happened after</span></p>
          <h2 id="proof-title">Real businesses, named by real AI answers.</h2>
        </div>

        <ul class="proof-list">
          {
            proofPoints.map(([company, platform, result]) => (
              <li class="proof-row">
                <span class="proof-row-platform">{platform}</span>
                <span class="proof-row-company">{company}</span>
                <span class="proof-row-result">{result}</span>
              </li>
            ))
          }
        </ul>

        <a class="header-action" href="/case-study">
          See all case studies <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="shell">
        <div class="final-grid">
          <div>
            <p class="eyebrow"><span>Get your quote</span></p>
            <h2 id="final-title">Find out what it takes to get you found.</h2>
            <p class="lede">
              Tell us about your business and we'll come back with a straight quote — where you stand in Google and
              AI search today, and what it costs to fix it.
            </p>
          </div>

          <div class="panel">
            <span class="panel-label">Work With Us</span>
            <LeadForm source="home-footer" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero h1 {
    max-width: 16ch;
  }

  /* Marquee, dark -------------------------------------------------------- */
  .marquee--dark {
    margin-top: var(--s12);
    background: var(--inverse-surface);
    border-color: var(--inverse-rule);
  }

  .marquee--dark .marquee-row + .marquee-row {
    border-top-color: var(--inverse-rule);
  }

  .marquee--dark .marquee-row--lead .marquee-track {
    color: var(--inverse-on);
    font-size: clamp(1.75rem, 4.2vw, 3.25rem);
  }

  .marquee--dark .marquee-row--sub .marquee-track {
    color: var(--inverse-muted);
  }

  /* Square separators rather than dots: the grid's own mark. */
  .marquee--dark .marquee-word::before {
    border-radius: 0;
    background: var(--signal);
  }

  @media (max-width: 720px) {
    .marquee--dark {
      margin-top: var(--s6);
    }
  }

  .pillar-grid {
    grid-template-rows: auto auto;
  }

  .pillar p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .proof-teaser {
    background: var(--surface-low);
  }

  .proof-list {
    display: grid;
    max-width: 68ch;
    margin: 0 0 var(--s6);
    padding: 0;
    list-style: none;
  }

  .proof-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--s3);
    align-items: baseline;
    padding-block: var(--s3);
    border-top: 1px solid var(--rule-light);
  }

  .proof-row:last-child {
    border-bottom: 1px solid var(--rule-light);
  }

  .proof-row-platform {
    color: var(--data-gray);
    font: 500 0.6875rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proof-row-company {
    grid-column: 2;
    color: var(--ink);
    font-weight: 700;
  }

  .proof-row-result {
    grid-column: 2;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 720px) {
    .proof-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }

    .proof-row-company,
    .proof-row-result {
      grid-column: 1;
    }
  }
</style>
