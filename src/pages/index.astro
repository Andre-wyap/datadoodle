---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "../components/LeadForm.astro";
import DisplayCards from "../components/DisplayCards.astro";
import logoLockup from "../assets/logo-lockup.png";

// Proof captures. Cropped from the originals in /Portfolio to the four things
// that make a capture evidence — the query, the platform, the named business
// and the citation — with browser chrome, side panels and dead space removed.
import sfgShot from "../assets/proof/sfg-perplexity.png";
import angBrothersShot from "../assets/proof/ang-brothers-google-aio.png";
import nookShot from "../assets/proof/nook-nook-perplexity.png";
import advancedShot from "../assets/proof/advanced-consultancy-perplexity.png";
import koreanShot from "../assets/proof/korean-explorer-perplexity.png";
import fourSolutionsShot from "../assets/proof/four-solutions-google-aio.png";

// One WebP per capture, feeding both the inline exhibit (~600px) and the
// lightbox (up to 1000px). 1300px covers the lightbox on a 4G phone without
// shipping the full crop; narrower crops are never upscaled.
const shot = async (image: ImageMetadata) => {
  const width = Math.min(1300, image.width);
  const height = Math.round((width * image.height) / image.width);
  const optimised = await getImage({ src: image, format: "webp", quality: 74, width });
  return { src: optimised.src, width, height };
};

// Marquee. Each group repeats enough times to outrun the widest viewport, then
// the whole group is duplicated once so translateX(-50%) loops seamlessly.
const disciplines = ["CHATGPT", "GEMINI", "PERPLEXITY", "CLAUDE"];
const promises = ["BE FOUND", "BE UNDERSTOOD", "BE RECOMMENDED"];
const repeat = <T,>(items: T[], times: number) => Array.from({ length: times }, () => items).flat();

// 02 — Why a good business still gets overlooked.
const problems = [
  [
    "Search Engine Optimisation (SEO)",
    "The Google layer. Site structure, page speed, internal linking and topic coverage, so the pages you already have rank for what your customers actually type. It is the foundation the other two stand on: a model cannot cite a page a crawler never understood.",
  ],
  [
    "Generative Engine Optimisation (GEO)",
    "ChatGPT, Gemini, Perplexity and AI Overviews don't rank ten blue links. They name one business, maybe three. We structure your entity, schema and proof so a model can state what you do, who you do it for and where you operate, then name you when someone asks for a recommendation.",
  ],
  [
    "Answer Engine Optimisation (AEO)",
    "Featured snippets, People Also Ask, voice assistants and Google Maps all pull a single direct answer. We write and mark up your pages so the answer they pull is yours: real questions, plain answers, details a machine can verify.",
  ],
];

// 03 — What we do about it.
const solutions = [
  ["Be found", "We check where you appear today across Google, ChatGPT, Gemini and Perplexity, and where your competitors appear instead."],
  ["Be understood", "We structure and label your business so a model can state what you do, who you do it for, and where you operate."],
  ["Be trusted", "Real proof, in a form a model can read and reuse: case studies, credentials, reviews and answered objections."],
  ["Be recommended", "We re-test the same questions after the work lands, and report what changed on each platform."],
];

// 01 — Case studies, carried by the carousel. One shape for all six so every
// card renders identically: the platform that produced the answer, the exact
// question asked, what the model did, and the date it was true. `caveat` is
// null when the result held steady across runs — it is not padding, and an
// empty one must stay empty rather than be filled with reassurance.
const cases = [
  {
    company: "Singapore Funeral Group",
    industry: "Funeral services — Singapore",
    platform: "Perplexity",
    query: "affordable funeral package singapore",
    result:
      "Named and cited with their own pricing, direct cremation from S$1,588, carried into the answer. Also named on ChatGPT, Gemini and Google's AI Overview.",
    resultType: "Named and cited",
    named: "Singapore Funeral Group, cited as funeralgroup",
    verified: "30 July 2026",
    caveat: null,
    shot: await shot(sfgShot),
  },
  {
    company: "Ang Brothers Funeral Services",
    industry: "Funeral services — Singapore",
    platform: "Google AI Overview",
    query: "my parents just passed who to contact for buddhist funeral",
    result:
      "Named first among trusted options, with their real 24-hour hotline quoted back to the reader. Also ChatGPT's top Buddhist-funeral pick.",
    resultType: "First named result",
    named: "Ang Brothers Funeral Services, listed first",
    verified: "30 July 2026",
    caveat: null,
    shot: await shot(angBrothersShot),
  },
  {
    company: "Four Solutions",
    industry: "Mould and pest control — Singapore",
    platform: "Google AI Overview",
    query: "best mould removal in singapore",
    result: "Named #1 for mould removal in Singapore, cited as foursolutions.sg.",
    resultType: "First named result",
    named: "Four Solutions, cited as foursolutions.sg",
    verified: "30 July 2026",
    caveat: "AI Overview varies run to run. Other runs name different providers.",
    shot: await shot(fourSolutionsShot),
  },
  {
    company: "Nook Nook",
    industry: "Event space rental — Singapore",
    platform: "Perplexity",
    query: "modular event space singapore",
    result: "Listed first for modular event space in Singapore, cited as nooknook.",
    resultType: "First named result",
    named: "Nook Nook, cited as nooknook",
    verified: "30 July 2026",
    caveat: null,
    shot: await shot(nookShot),
  },
  {
    company: "Advanced Consultancy",
    industry: "Business consultancy — Singapore",
    platform: "Perplexity",
    query: "best business management consultancy for SMEs in singapore",
    result: "Named first on a shortlist of SME consultancies, cited as advancedconsultancy.com.",
    resultType: "First named result",
    named: "Advanced Consultancy, cited as advancedconsultancy.com",
    verified: "30 July 2026",
    caveat: null,
    shot: await shot(advancedShot),
  },
  {
    company: "Korean Explorer",
    industry: "Language school — Singapore",
    platform: "Perplexity",
    query: "where to learn korean language in singapore",
    result: "Appears in the recommended shortlist of Korean language schools in Singapore.",
    resultType: "Shortlist appearance",
    named: "Korean Explorer, in the recommended shortlist",
    verified: "30 July 2026",
    caveat: "Named inconsistently between runs: a shortlist appearance, not a fixed position.",
    shot: await shot(koreanShot),
  },
];

// 05 — Benefits.
const benefits = [
  ["Get discovered earlier", "Appear during the customer’s research process."],
  ["Build trust before contact", "Being referenced by AI can strengthen credibility."],
  ["Support your advertising", "Meta ads create awareness. AI visibility supports research and trust."],
  ["Move before competitors", "Improve your visibility before the market becomes crowded."],
];

// 06 — How it works.
const stages = [
  ["Audit", "We record where you appear today across each major AI platform, and audit up to three named competitors appearing instead of you."],
  ["Identify", "Our in-house AI tools identify the gaps: missing keywords, unclear information, questions your site never answers."],
  ["Improve", "We rebuild your website, or build on top of what you already have, so a model can understand and cite your business."],
  ["Deploy", "Your new site goes live within 30 days, structured, tested, and ready to be found."],
  [
    "Report",
    "You get the before and after, per platform, with the exact wording each model used to describe you, plus the fixes still worth making next.",
  ],
];

// 08 — Who this suits. Alternating fills give the grid its rhythm.
const industries = [
  "Professional services",
  "Consultancy",
  "Healthcare",
  "Education",
  "Events",
  "Home services",
  "Financial services",
  "Local businesses",
];

// 15 — FAQ.
const faqs = [
  [
    "What is AI search optimisation?",
    "It is the work of making your business understandable and citable by AI systems, so that when someone asks ChatGPT, Gemini, Perplexity or Google’s AI Overview for a recommendation, your business is one of the names it has to give.",
  ],
  [
    "Is this the same as SEO?",
    "Related, but not the same job. SEO optimises for a position in a list of links. This optimises for being named inside an answer, where there is no page two and usually no more than three names.",
  ],
  [
    "How long does it take?",
    "The typical engagement runs about 30 days from kickoff to the final report. Audit and Identify take the first week; Improve and Deploy take the rest.",
  ],
  [
    "Can you guarantee placement?",
    "No, and be careful with anyone who does. AI answers vary by phrasing, location and model version, and they change without notice. What we guarantee is the work, the testing, and an honest before-and-after record of what we found.",
  ],
  [
    "How will I know whether it is working?",
    "We re-run the same questions on the same platforms after the work lands, and show you the answers side by side with dates. You see the wording the model used, not a number we made up.",
  ],
  [
    "Do I still need a website?",
    "Yes. Your website is where the models read from. If it does not clearly state what you do, who you serve and where, there is nothing for an answer to be built from.",
  ],
  [
    "Do I still need Meta ads?",
    "If they work for you, keep them. Ads create awareness; AI visibility supports the research and trust step that happens after. They do different jobs.",
  ],
  [
    "Which AI platforms do you work with?",
    "ChatGPT, Google AI Overview, Gemini and Perplexity. Each is checked and reported separately, because the same question can produce four different answers.",
  ],
];

const navLinks: [string, string][] = [
  ["#how-it-works", "How It Works"],
  ["#results", "Results"],
  ["#faq", "FAQ"],
];

// A fixed field of Signal Red cells over the background grid. Seeded, so the
// scatter is identical on every render and never re-flows the page.
const seeded = (seed: number) => {
  let value = seed;
  return () => {
    value = (value * 1664525 + 1013904223) % 4294967296;
    return value / 4294967296;
  };
};
const nextMark = seeded(20260731);
const gridMarks = Array.from({ length: 16 }, () => ({
  left: Math.round(nextMark() * 96 * 100) / 100,
  top: Math.round(nextMark() * 96 * 100) / 100,
}));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": "https://datadoodles.my/#organization",
      name: "DataDoodles",
      url: "https://datadoodles.my/",
      areaServed: { "@type": "AdministrativeArea", name: "Klang Valley, Malaysia" },
      description:
        "DataDoodles measures how AI sees your business and improves your chance of becoming the recommended answer on ChatGPT, Google AI Overview, Gemini and Perplexity.",
    },
    {
      "@type": "Service",
      name: "GEO / AI Search Visibility",
      serviceType: "Generative Engine Optimisation",
      provider: { "@id": "https://datadoodles.my/#organization" },
      areaServed: "Malaysia",
      audience: { "@type": "BusinessAudience", audienceType: "Established small and medium businesses" },
    },
    {
      "@type": "FAQPage",
      "@id": "https://datadoodles.my/#faq",
      mainEntity: faqs.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber.replace(/\D/g, "")}?text=Hi%20DataDoodles%2C%20I%27d%20like%20to%20work%20with%20you.`
  : "#visibility-check";
---

<BaseLayout
  title="DataDoodles — Become the business AI recommends"
  description="We measure how ChatGPT, Google AI Overview, Gemini and Perplexity see your business, and improve your chance of being the recommended answer. Typical timeline: 30 days."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <header class="site-header" id="top" data-header>
    <div class="shell">
      <a class="brand" href="#top" aria-label="DataDoodles home">
        <Image src={logoLockup} alt="DataDoodles" width={278} height={52} loading="eager" />
      </a>

      <nav class="site-nav" aria-label="Sections">
        <ul>
          {navLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <a class="header-action" href="#visibility-check">
        Get a consultation <span aria-hidden="true">→</span>
      </a>

      {/* Hidden from the desktop layout in CSS, so one set of markup serves both. */}
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="sr-only" data-nav-toggle-label>Open menu</span>
      </button>
    </div>

    <div class="nav-panel" id="nav-panel" data-nav-panel>
      <nav class="shell" aria-label="Sections menu">
        <ul>
          {navLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
        <a class="nav-panel-cta" href="#visibility-check">Get a consultation</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero — 7 columns of copy, 5 columns of evidence ------------------- -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell">
        <div class="hero-grid">
          <div>
            <p class="hero-kicker" data-anim>Let Your Website Seen by AI</p>
            <h1 id="hero-title">
              <span class="accent">
                <span class="w" style="--i:0">AI</span> <span class="w" style="--i:1">Recommend</span>
              </span>
              <span class="w" style="--i:2">=</span>
              <span class="w" style="--i:3">More</span>
              <span class="w" style="--i:4">Traffic</span>
              <span class="w" style="--i:5">=</span>
              <span class="hl">
                <span class="w" style="--i:6">More</span> <span class="w" style="--i:7">Sales</span>
              </span>
            </h1>
            <p class="hero-subhead" data-anim style="--delay:260ms">Become the Business AI Recommends in 30 Days</p>
            <p class="hero-sub" data-anim style="--delay:300ms">
              Your customers are asking ChatGPT, Gemini, Perplexity and Google’s AI Overview who to choose.
            </p>

            <div class="hero-actions" data-anim style="--delay:380ms">
              <a class="hero-cta" href="#visibility-check">
                Get your quotation <span aria-hidden="true">→</span>
              </a>
              <a class="hero-link" href="#results">Our work</a>
            </div>
          </div>

          <div class="hero-exhibit" data-anim style="--delay:200ms">
            <p class="exhibit-label">Your potential clients are searching</p>
            <DisplayCards />
          </div>
        </div>
      </div>

      <p class="sr-only">
        DataDoodles works on Generative Engine Optimisation, Answer Engine Optimisation and Search Engine Optimisation.
      </p>

      <!-- Hero marquee — full-bleed, dark ------------------------------------ -->
      <div class="marquee marquee--dark" aria-hidden="true">
        <div class="marquee-row marquee-row--lead">
          <div class="marquee-track" style="--speed:96s">
            {
              [0, 1].map(() => (
                <div class="marquee-group">
                  {repeat(disciplines, 3).map((word) => (
                    <span class="marquee-word">{word}</span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>

        <div class="marquee-row marquee-row--sub">
          <div class="marquee-track marquee-track--reverse" style="--speed:72s">
            {
              [0, 1].map(() => (
                <div class="marquee-group">
                  {repeat(promises, 8).map((phrase) => (
                    <span class="marquee-word">{phrase}</span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 01 Case-study proof — horizontal carousel -------------------------- -->
    <section class="section" id="results" aria-labelledby="results-title">
      <div class="shell">
        <div class="section-head section-head--wide" data-reveal>
          <p class="eyebrow"><span>Evidence</span><span class="eyebrow-idx">01</span></p>
          <h2 id="results-title">We Ranked Our Clients</h2>
          <p class="lede">
            We've helped more than 70 businesses get found on Google and in AI search: ChatGPT, Gemini, Perplexity
            and Google AI Overview. Every capture below is dated, and proves what was true on that date.
          </p>
          <a class="hero-cta results-cta" href="#visibility-check">
            See If We're a Good Fit <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="carousel" data-carousel data-reveal>
          <div class="carousel-controls">
            <button type="button" class="carousel-arrow" data-carousel-prev aria-label="Previous case studies">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button type="button" class="carousel-arrow" data-carousel-next aria-label="Next case studies">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>

          {/* The track is the scroll container, so it works by swipe and trackpad
              with the arrows off. tabindex makes it keyboard-scrollable too. */}
          <ul class="carousel-track" data-carousel-track tabindex="0" role="list" aria-label="Case studies">
            {
              cases.map((item) => (
                <li class="case">
                  <figure class="case-shot">
                    <img
                      src={item.shot.src}
                      alt={`${item.platform} answering “${item.query}”, with ${item.named}. Captured ${item.verified}.`}
                      width={item.shot.width}
                      height={item.shot.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>

                  <div class="case-body">
                    <p class="case-platform">{item.platform}</p>
                    <h3>{item.company}</h3>
                    <p class="case-industry">{item.industry}</p>
                    <p class="case-result">{item.result}</p>

                    <dl class="record">
                      <div>
                        <dt>Query</dt>
                        <dd>{item.query}</dd>
                      </div>
                      <div>
                        <dt>Verified</dt>
                        <dd>{item.verified}</dd>
                      </div>
                      <div>
                        <dt>Result type</dt>
                        <dd>{item.resultType}</dd>
                      </div>
                    </dl>

                    {item.caveat && <p class="case-caveat">{item.caveat}</p>}

                    <button
                      type="button"
                      class="proof-action"
                      data-proof
                      data-proof-src={item.shot.src}
                      data-proof-company={item.company}
                      data-proof-query={item.query}
                      data-proof-platform={item.platform}
                      data-proof-verified={item.verified}
                      data-proof-caveat={item.caveat || ""}
                    >
                      View proof <span aria-hidden="true">→</span>
                    </button>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 02 Problem --------------------------------------------------------- -->
    <section class="section" aria-labelledby="problem-title">
      <div class="shell">
        <div class="split-grid">
          <div data-reveal>
            <p class="eyebrow"><span>Our services</span><span class="eyebrow-idx">02</span></p>
            <h2 id="problem-title">We get your website shown in 3 places.</h2>
            <a class="hero-cta section-cta" href="#visibility-check">
              Get a website audit <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="problem-stack">
            {
              problems.map(([title, copy], i) => (
                <article class="dark-card" data-reveal style={`--i:${i}`}>
                  <p class="dark-card-idx">{String(i + 1).padStart(2, "0")}</p>
                  <h3>{title}</h3>
                  <p>{copy}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Solution -------------------------------------------------------- -->
    <section class="section section--white" aria-labelledby="solution-title">
      <div class="shell">
        <div class="section-head section-head--wide" data-reveal>
          <p class="eyebrow"><span>What we do</span><span class="eyebrow-idx">03</span></p>
          <h2 id="solution-title">We help your business become part of the answer.</h2>
          <a class="hero-cta section-cta" href="#visibility-check">
            Get a consultation <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="col-grid solution-grid">
          {
            solutions.map(([title, copy], i) => (
              <article class="col solution" data-reveal style={`--i:${i}`}>
                <p class="step-no">{String(i + 1).padStart(2, "0")}</p>
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 05 Benefits -------------------------------------------------------- -->
    <section class="section" aria-labelledby="benefits-title">
      <div class="shell">
        <div class="section-head section-head--wide" data-reveal>
          <p class="eyebrow"><span>What it gets you</span><span class="eyebrow-idx">04</span></p>
          <h2 id="benefits-title">Why this matters now.</h2>
          <a class="hero-cta section-cta" href="#visibility-check">
            Let's Work Together <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="benefit-grid">
          {
            benefits.map(([title, copy], i) => (
              <article class="dark-card dark-card--benefit" data-reveal style={`--i:${i % 2}`}>
                <p class="dark-card-idx">{String(i + 1).padStart(2, "0")}</p>
                <h3>{title}</h3>
                <p>{copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 06 How it works ---------------------------------------------------- -->
    <section class="section section--low" id="how-it-works" aria-labelledby="how-title">
      <div class="shell">
        <div class="section-head section-head--wide" data-reveal>
          <p class="eyebrow"><span>The process</span><span class="eyebrow-idx">05</span></p>
          <h2 id="how-title">Five stages. One clear record at the end.</h2>
        </div>

        <div class="how-grid">
          <div class="timeline stage-timeline" data-reveal>
            <ol>
              {
                stages.map(([title, copy], i) => (
                  <li style={`--i:${i}`}>
                    <span class="node" aria-hidden="true" />
                    <p class="week">{String(i + 1).padStart(2, "0")}</p>
                    <h3>{title}</h3>
                    <p>{copy}</p>
                  </li>
                ))
              }
            </ol>
          </div>

          <aside class="how-aside" data-reveal>
            <p class="how-aside-label">Typical timeline</p>
            <p class="how-aside-figure">30<span>days</span></p>
            <p class="how-aside-note">
              Approximately. Audit and Identify run in the first week; Improve and Deploy take the rest. You get the
              report whether or not the answers moved.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <!-- 07 Suitable business types ----------------------------------------- -->
    <section class="section" aria-labelledby="industries-title">
      <div class="shell">
        <div class="section-head section-head--wide" data-reveal>
          <p class="eyebrow"><span>Who this suits</span><span class="eyebrow-idx">06</span></p>
          <h2 id="industries-title">Businesses customers research before they call.</h2>
          <a class="hero-cta section-cta" href="#visibility-check">
            Get a website audit <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul class="industry-grid">
          {
            industries.map((label, i) => (
              <li class="industry" data-reveal style={`--i:${i % 4}`}>
                <span class="industry-no">{String(i + 1).padStart(2, "0")}</span>
                <span class="industry-name">{label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 08 Lead form — full-bleed, inverted -------------------------------- -->
    <section class="lead-section" id="visibility-check" aria-labelledby="lead-title">
      <div class="shell">
        <div class="lead-grid">
          <div data-reveal>
            <p class="eyebrow"><span>Visibility check</span><span class="eyebrow-idx">07</span></p>
            <h2 id="lead-title">Want to work with us?</h2>
            <p class="lede">
              We run your business through ChatGPT, Gemini, Perplexity and Google’s AI Overview, record what comes back,
              and show you who is appearing instead of you.
            </p>

            <ul class="lead-benefits">
              <li>See exactly what AI says about you today</li>
              <li>See which competitors get named first</li>
              <li>See the gaps worth fixing first</li>
            </ul>

