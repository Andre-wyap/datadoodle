      background: var(--inverse-surface);
      border: 1px solid var(--inverse-rule);
      border-radius: 4px;
      color: var(--inverse-muted);
      overflow: hidden;
    }

    /* A Signal Red rule that runs the row's length on hover. */
    .reason::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 2px;
      background: var(--signal);
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform 200ms var(--ease);
    }

    .reason:hover::after,
    .reason:focus-within::after {
      transform: scaleX(1);
    }

    .reason-no {
      color: var(--inverse-muted);
      font: 500 0.75rem/1.6 var(--font-mono);
      letter-spacing: 0.08em;
    }

    .reason h3 {
      margin-bottom: 6px;
      color: var(--inverse-on);
      font-size: 1.0625rem;
    }

    .reason p {
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    /* 10 — Lead section --------------------------------------------------- */
    .lead-section {
      padding-block: var(--section-space);
      background: var(--inverse-surface);
      color: var(--inverse-on);
      border-bottom: 1px solid var(--inverse-rule);
    }

    .lead-section h2 {
      max-width: 16ch;
      color: var(--inverse-on);
    }

    .lead-section .eyebrow {
      color: var(--inverse-muted);
    }

    .lead-section .eyebrow::after {
      background: var(--inverse-rule);
    }

    .lead-section .eyebrow-idx {
      color: var(--inverse-on);
    }

    .lead-section .lede {
      max-width: 48ch;
      margin-top: var(--s3);
      color: var(--inverse-muted);
      font-size: 1.0625rem;
    }

    .lead-grid {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(360px, 5fr);
      gap: var(--split-gap);
      align-items: start;
    }

    .lead-benefits {
      display: grid;
      gap: 10px;
      margin: var(--s6) 0 0;
      padding: var(--s5) 0 0;
      border-top: 1px solid var(--inverse-rule);
      list-style: none;
    }

    .lead-benefits li {
      position: relative;
      padding-left: 20px;
      color: var(--inverse-on);
      font-size: 0.9375rem;
    }

    .lead-benefits li::before {
      content: "";
      position: absolute;
      top: 0.55em;
      left: 0;
      width: 6px;
      height: 6px;
      background: var(--signal);
    }

    .lead-process {
      margin-top: var(--s6);
      color: var(--inverse-muted);
      font: 500 0.75rem/1.4 var(--font-mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* The form container stays white inside the dark section. */
    .lead-section .panel {
      border-color: var(--rule);
    }

    /* Signal Red detail on the primary action's hover, never as its fill. */
    .lead-section .submit-button:hover {
      background: var(--ink);
      box-shadow: inset 0 -3px 0 0 var(--signal);
    }

    /* Final CTA ----------------------------------------------------------- */
    .closing {
      position: relative;
      padding-block: clamp(96px, 10vw, 144px);
      background: var(--inverse-surface);
      color: var(--inverse-on);
      overflow: hidden;
      text-align: center;
    }

    /* The technical grid, made visible for one section, with a deterministic
       scatter of Signal Red cells. */
    .closing-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 26px 26px;
      pointer-events: none;
    }

    .closing-grid i {
      position: absolute;
      width: 6px;
      height: 6px;
      background: var(--signal);
      opacity: 0.55;
    }

    .closing .shell {
      position: relative;
    }

    .closing h2 {
      max-width: 20ch;
      margin-inline: auto;
      color: var(--inverse-on);
      font-size: clamp(2rem, 4.4vw, 3.25rem);
    }

    .closing-sub {
      max-width: 46ch;
      margin: var(--s4) auto 0;
      color: var(--inverse-muted);
      font-size: 1.125rem;
    }

    .hl--closing {
      color: var(--inverse-on);
      font-weight: 700;
    }

    .closing-cta {
      display: inline-flex;
      align-items: center;
      min-height: 56px;
      margin-top: var(--s8);
      padding: 0 var(--s5);
      background: var(--surface);
      border-radius: 4px;
      color: var(--ink);
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      transition: box-shadow 200ms var(--ease), transform 120ms var(--ease);
    }

    .closing-cta:hover {
      box-shadow: inset 0 -3px 0 0 var(--signal);
    }

    .closing-cta:active {
      transform: translateY(1px);
    }

    .closing-note {
      margin-top: var(--s5);
      color: var(--inverse-muted);
      font: 500 0.75rem/1.6 var(--font-mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* Footer --------------------------------------------------------------- */
    .site-footer--dark {
      padding-block: var(--s10) var(--s8);
      background: var(--ink-body);
      color: var(--inverse-muted);
    }

    .site-footer--dark .shell {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s8) var(--s5);
      align-items: start;
      color: inherit;
    }

    /* The system's footer right-aligns its last paragraph. This footer is a
       four-block grid, so every column reads from the same left edge. */
    .site-footer--dark p {
      text-align: left;
    }

    .footer-line {
      margin-top: var(--s3);
      color: var(--inverse-muted);
      font: 500 0.75rem/1.4 var(--font-mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* The only lockup is drawn in ink. On the dark footer it is knocked out to
       white rather than sitting invisible against the surface. */
    .site-footer--dark .brand img {
      height: 24px;
      filter: brightness(0) invert(1);
    }

    .footer-nav ul,
    .footer-contact {
      display: grid;
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer-nav a,
    .footer-contact a {
      color: var(--inverse-on);
      font-size: 0.875rem;
      text-decoration: none;
      transition: color 180ms var(--ease);
    }

    .footer-nav a:hover,
    .footer-contact a:hover,
    .footer-legal a:hover {
      color: var(--signal);
    }

    .footer-contact p {
      font-size: 0.875rem;
    }

    .footer-legal {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: var(--s3) var(--s5);
      align-items: baseline;
      justify-content: space-between;
      padding-top: var(--s5);
      border-top: 1px solid var(--inverse-rule);
      font-size: 0.8125rem;
    }

    .footer-legal a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }

    .footer-stamp {
      color: var(--inverse-muted);
      font: 500 0.6875rem/1.5 var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Proof lightbox -------------------------------------------------------- */
    .proof-modal {
      width: min(94vw, 1000px);
      max-height: min(90vh, 900px);
      margin: auto;
      padding: var(--s5);
      overflow-y: auto;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
      color: var(--ink-body);
    }

    .proof-modal::backdrop {
      background: rgba(17, 17, 17, 0.86);
    }

    .proof-modal h2 {
      margin: 0 var(--s6) var(--s4) 0;
      font-size: clamp(1.25rem, 2vw, 1.5rem);
    }

    .proof-modal img {
      width: 100%;
      height: auto;
      margin-bottom: var(--s4);
      background: var(--inverse-surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
    }

    /* A capture that moves between runs says so, in the accent reserved for
       result marks — the claim and its limit arrive together. */
    .proof-modal-caveat {
      margin-top: var(--s4);
      padding-left: var(--s3);
      border-left: 2px solid var(--signal);
      color: var(--ink);
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.55;
    }

    .proof-modal-caveat[hidden] {
      display: none;
    }

    .proof-modal-note {
      margin-top: var(--s4);
      color: var(--muted);
      font-size: 0.8125rem;
      line-height: 1.6;
    }

    .proof-modal-close {
      position: absolute;
      top: var(--s3);
      right: var(--s3);
      display: grid;
      width: 40px;
      height: 40px;
      place-items: center;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 4px;
      color: var(--ink);
      cursor: pointer;
      transition: border-color 180ms var(--ease);
    }

    .proof-modal-close:hover {
      border-color: var(--ink);
    }

    /* Sticky mobile bar ----------------------------------------------------- */
    .mobile-actions .score-link {
      background: var(--ink);
      color: var(--surface);
    }

    /* Motion ---------------------------------------------------------------- */
    /* Everything below is armed by the `js` class and runs once. Nothing over
       300ms except the two draws, which are load/reveal moments, not UI. */

    /* Each section's measuring rule extends as the section arrives. */
    :global(html.js) [data-reveal] .eyebrow::after {
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform 500ms var(--ease) 120ms;
    }

    :global(html.js) [data-reveal].revealed .eyebrow::after {
      transform: scaleX(1);
    }

    /* The timeline's progress line draws along its length, then the nodes land. */
    :global(html.js) .stage-timeline ol::after {
      transform: scaleX(0);
      transition: transform 560ms var(--ease) 140ms;
    }

    :global(html.js) .stage-timeline.revealed ol::after {
      transform: scaleX(1);
    }

    :global(html.js) .stage-timeline .node {
      opacity: 0;
      transform: scale(0.4);
      transition:
        opacity 200ms var(--ease) calc(300ms + var(--i, 0) * 90ms),
        transform 200ms var(--ease) calc(300ms + var(--i, 0) * 90ms);
    }

    :global(html.js) .stage-timeline.revealed .node {
      opacity: 1;
      transform: none;
    }

    /* The hero's recommendation mark lands last in the load sequence. */
    :global(html.js) .hero .ai-row--named {
      animation: tag-in 300ms var(--ease) 780ms both;
    }

    /* Responsive ------------------------------------------------------------ */
    @media (max-width: 1080px) {
      .split-grid,
      .shift-grid,
      .lead-grid,
      .how-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .solution-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: none;
        row-gap: var(--s8);
      }

      .solution {
        display: block;
      }

      .solution > * + * {
        margin-top: var(--s2);
      }

      .support-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .support:nth-child(odd) {
        border-left: 0;
      }

      .support:nth-child(n + 3) {
        border-top: 1px solid var(--inverse-rule);
      }

      .industry-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .industry:nth-child(even) {
        border-right: 0;
      }

      .industry:nth-child(n + 5) {
        border-bottom: 1px solid var(--rule-light);
      }

      .industry:nth-child(n + 7) {
        border-bottom: 0;
      }

      .site-footer--dark .shell {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .hero h1 {
        max-width: none;
      }

      .hero-actions {
        gap: var(--s3);
      }

      .hero-cta {
        width: 100%;
        justify-content: center;
      }

      .marquee--dark {
        margin-top: var(--s6);
      }

      .feature-grid,
      .benefit-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .solution-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      /* Supporting cases swipe horizontally rather than stacking four deep. */
      .support-grid {
        display: flex;
        margin-inline: calc(var(--gutter) * -1);
        padding-inline: var(--gutter);
        overflow-x: auto;
        border-inline: 0;
        border-radius: 0;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
      }

      .support {
        flex: 0 0 78%;
        scroll-snap-align: start;
      }

      .support:nth-child(n) {
        border-top: 0;
        border-left: 1px solid var(--inverse-rule);
      }

      .support:first-child {
        border-left: 0;
      }

      /* The five stages become a vertical line, same red progress rule. */
      .stage-timeline ol {
        padding-left: var(--s4);
      }

      .stage-timeline ol::after {
        inset: 5px auto 5px 3px;
        width: 2px;
        height: auto;
      }

      :global(html.js) .stage-timeline ol::after {
        transform: scaleY(0);
        transform-origin: 50% 0;
      }

      :global(html.js) .stage-timeline.revealed ol::after {
        transform: scaleY(1);
      }

      .stage-timeline .node {
        left: calc(var(--s4) * -1 - 0.5px);
      }

      .versus {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--s6);
      }

      .versus-side--ai {
        padding: var(--s5) 0 0;
        border-top: 1px solid var(--inverse-rule);
      }

      .versus-divider {
        display: none;
      }

      .industry-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .industry {
        min-height: 0;
        gap: var(--s3);
        border-right: 0;
        border-bottom: 1px solid var(--rule-light);
      }

      .industry:last-child {
        border-bottom: 0;
      }

      .reason {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--s2);
      }

      .site-footer--dark .shell {
        grid-template-columns: minmax(0, 1fr);
      }

      .footer-legal {
        justify-content: flex-start;
      }

      .grid-bg {
        background-size: 22px 22px;
      }

      .closing-grid {
        background-size: 22px 22px;
      }

      .pixels {
        display: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .grid-bg,
      .closing-grid {
        opacity: 0.6;
      }
    }
  </style>
</BaseLayout>
