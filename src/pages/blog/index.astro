---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import PixelField from "../../components/PixelField.astro";

export const prerender = true;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat("en-MY", { year: "numeric", month: "short", day: "numeric" });
---

<BlogLayout
  title="GEO & AI Search Insights — DataDoodles Blog"
  description="Guides on Generative Engine Optimization, Answer Engine Optimization, and getting cited by ChatGPT, Perplexity, and Google AI Overviews — written for SME owners in Malaysia and Singapore."
>
  <section class="blog-hero">
    <PixelField />
    <div class="shell">
      <p class="eyebrow"><span>GEO &amp; AI SEARCH INSIGHTS</span></p>
      <h1>What it takes to get recommended by AI.</h1>
      <p class="blog-hero-sub">
        Guides on Generative Engine Optimization, Answer Engine Optimization, and website structure — written for
        business owners in Malaysia and Singapore.
      </p>
    </div>
  </section>

  <section class="blog-list section">
    <div class="shell">
      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-row">
              <a href={`/blog/${post.id}`}>
                <span class="post-row-meta">
                  <span class="post-row-category">{post.data.category}</span>
                  <span class="post-row-date">{dateFmt.format(post.data.date)}</span>
                </span>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BlogLayout>

<style>
  .blog-hero {
    padding-block: clamp(56px, 7vw, 96px) var(--s10);
  }

  .blog-hero .eyebrow {
    display: inline-flex;
    margin-bottom: var(--s5);
  }

  .blog-hero .eyebrow::after {
    display: none;
  }

  .blog-hero h1 {
    max-width: 18ch;
  }

  .blog-hero-sub {
    max-width: 56ch;
    margin-top: var(--s5);
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .blog-list {
    padding-top: 0;
  }

  .post-list {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .post-row {
    border-top: 1px solid var(--rule-light);
  }

  .post-row:last-child {
    border-bottom: 1px solid var(--rule-light);
  }

  .post-row a {
    display: block;
    padding-block: var(--s6);
    text-decoration: none;
    transition: opacity 160ms var(--ease);
  }

  .post-row a:hover {
    opacity: 0.72;
  }

  .post-row a:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .post-row-meta {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s3);
    color: var(--data-gray);
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-row-category {
    color: var(--ink);
  }

  .post-row h2 {
    max-width: 54ch;
    margin-bottom: var(--s2);
    font-size: clamp(1.3rem, 1.9vw, 1.625rem);
  }

  .post-row p {
    max-width: 68ch;
    color: var(--muted);
  }
</style>
