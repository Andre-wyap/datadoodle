---
const question = "Which clinic in Puchong is best for paediatric dentistry?";
---

<figure
  class="geo-simulator"
  data-geo-simulator
  aria-label="Illustrative AI search recommendation generated for a paediatric dentistry query in Puchong"
>
  <div class="geo-simulator__stage">
    <p class="geo-simulator__question" data-geo-bubble>
      <span class="geo-simulator__question-text" data-geo-bubble-text>{question}</span>
    </p>

    <div class="geo-simulator__processing" data-geo-processing aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <div class="geo-simulator__answer" data-geo-answer>
      <p class="geo-simulator__answer-label" data-geo-response>ChatGPT Answer</p>

      <ol class="geo-simulator__recommendations">
        <li
          class="geo-simulator__recommendation geo-simulator__recommendation--primary"
          data-geo-recommendation="primary"
        >
          <span class="geo-simulator__number">1.</span>
          <span class="geo-simulator__business">Your business name</span>
        </li>
        <li class="geo-simulator__recommendation" data-geo-recommendation="secondary">
          <span class="geo-simulator__number">2.</span>
          <span>Your competitor 1</span>
        </li>
        <li class="geo-simulator__recommendation" data-geo-recommendation="secondary">
          <span class="geo-simulator__number">3.</span>
          <span>Your competitor 2</span>
        </li>
      </ol>
    </div>

    <div class="geo-simulator__composer" data-geo-composer aria-hidden="true">
      <div class="geo-simulator__field">
        <span class="geo-simulator__placeholder" data-geo-placeholder>Ask anything</span>
        <span class="geo-simulator__field-line">
          <span data-geo-typed data-question={question}></span><span
            class="geo-simulator__cursor"
            data-geo-cursor
          ></span>
        </span>
      </div>
      <span class="geo-simulator__send" data-geo-send>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <path
            d="M12 19V5M12 5l-6 6M12 5l6 6"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</figure>

<script>
  const DURATION = 10_000;
  // One column, centred: the field types, becomes the question bubble in place,
  // and only leaves — upward — as the grey answer bubble takes the centre.
  const COMPOSER_IN = 250;
  const TYPE_START = 400;
  const TYPE_DURATION = 2_400;
  const SEND_AT = 3_000;
  const MORPH_AT = 3_060;
  const MORPH_DURATION = 320;
  const HANDOVER_AT = 4_300;
  const BUBBLE_LIFT_DURATION = 300;
  const BUBBLE_LIFT_DISTANCE = 32;
  const PROCESSING_AT = 4_420;
  const PROCESSING_UNTIL = 4_900;
  const ANSWER_AT = 4_900;
  const ANSWER_IN_DURATION = 320;
  const RESPONSE_STARTS = [5_100];
  const PRIMARY_AT = 5_500;
  const SECONDARY_STARTS = [5_800, 6_050];
  const FADE_AT = 8_600;
  const FADE_DURATION = 800;

  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));
  const progress = (elapsed: number, start: number, duration: number) => clamp((elapsed - start) / duration);
  const easeOut = (value: number) => 1 - Math.pow(1 - value, 3);
  const mix = (from: number, to: number, at: number) => from + (to - from) * at;

  document.querySelectorAll<HTMLElement>("[data-geo-simulator]:not([data-geo-ready])").forEach((simulator) => {
    const stage = simulator.querySelector<HTMLElement>(".geo-simulator__stage");
    const bubble = simulator.querySelector<HTMLElement>("[data-geo-bubble]");
    const bubbleText = simulator.querySelector<HTMLElement>("[data-geo-bubble-text]");
    const answer = simulator.querySelector<HTMLElement>("[data-geo-answer]");
    const composer = simulator.querySelector<HTMLElement>("[data-geo-composer]");
    const typed = simulator.querySelector<HTMLElement>("[data-geo-typed]");
    const placeholder = simulator.querySelector<HTMLElement>("[data-geo-placeholder]");
    const send = simulator.querySelector<HTMLElement>("[data-geo-send]");
    const cursor = simulator.querySelector<HTMLElement>("[data-geo-cursor]");
    const processing = simulator.querySelector<HTMLElement>("[data-geo-processing]");
    const dots = Array.from(processing?.querySelectorAll<HTMLElement>("span") ?? []);
    const responseGroups = Array.from(simulator.querySelectorAll<HTMLElement>("[data-geo-response]"));
    const primary = simulator.querySelector<HTMLElement>('[data-geo-recommendation="primary"]');
    const secondary = Array.from(simulator.querySelectorAll<HTMLElement>('[data-geo-recommendation="secondary"]'));
    const completeQuestion = typed?.dataset.question ?? "";

    if (
      !stage ||
      !bubble ||
      !bubbleText ||
      !answer ||
      !composer ||
      !typed ||
      !placeholder ||
      !send ||
      !cursor ||
      !processing ||
      !primary
    )
      return;

    let frame = 0;
    let startedAt = 0;
    let visible = false;
    let destroyed = false;

    // Offsets, not bounding rects: they ignore the transforms we are applying,
    // so the morph can be re-measured at any point in the loop. Both boxes are
    // centred on the same axis, so only width, height and left differ.
    let morph = { x: 0, scaleX: 1, scaleY: 1, restY: 0, startY: 0 };
    let measured = false;

    const measure = () => {
      morph = {
        x: composer.offsetLeft - bubble.offsetLeft,
        scaleX: bubble.offsetWidth ? composer.offsetWidth / bubble.offsetWidth : 1,
        scaleY: bubble.offsetHeight ? composer.offsetHeight / bubble.offsetHeight : 1,
        restY: -bubble.offsetHeight / 2,
        startY: -composer.offsetHeight / 2,
      };
      measured = true;
    };

    const setOpacity = (element: HTMLElement | SVGElement, value: number) => {
      element.style.opacity = String(clamp(value));
    };

    const setRise = (element: HTMLElement, value: number, distance = 8) => {
      const eased = easeOut(clamp(value));
      setOpacity(element, eased);
      element.style.transform = `translateY(${(1 - eased) * distance}px)`;
    };

    const renderComplete = () => {
      typed.textContent = "";
      setOpacity(composer, 1);
      composer.style.transform = "none";
      setOpacity(placeholder, 1);
      setOpacity(cursor, 0);
      send.style.transform = "none";
      setOpacity(send, 1);
      setOpacity(bubble, 1);
      bubble.style.transform = "none";
      setOpacity(bubbleText, 1);
      setOpacity(answer, 1);
      answer.style.transform = "none";
      setOpacity(processing, 0);
      responseGroups.forEach((group) => {
        setOpacity(group, 1);
        group.style.transform = "none";
      });
      setOpacity(primary, 1);
      primary.style.transform = "none";
      secondary.forEach((item) => {
        setOpacity(item, 1);
        item.style.transform = "none";
      });
      dots.forEach((dot) => {
        dot.style.opacity = "0";
        dot.style.transform = "none";
      });
    };

    const render = (elapsed: number) => {
      if (!measured) measure();

      const fadeOut = elapsed >= FADE_AT ? 1 - progress(elapsed, FADE_AT, FADE_DURATION) : 1;

      // Composer: centred in the frame, types the query, then hands its shape
      // to the bubble and gets out of the way.
      const composerIn = easeOut(progress(elapsed, 0, COMPOSER_IN));
      const composerOut = progress(elapsed, MORPH_AT, 140);
      setOpacity(composer, composerIn * (1 - composerOut) * fadeOut);
      composer.style.transform = "translateY(-50%)";

      const typeProgress = progress(elapsed, TYPE_START, TYPE_DURATION);
      typed.textContent = completeQuestion.slice(0, Math.floor(typeProgress * completeQuestion.length));

      setOpacity(placeholder, 1 - progress(elapsed, TYPE_START - 60, 150));

      const cursorActive = elapsed >= TYPE_START && elapsed < SEND_AT;
      const cursorBlink = Math.floor((elapsed - TYPE_START) / 300) % 2 === 0;
      setOpacity(cursor, cursorActive && cursorBlink ? 1 : 0);

      // Send button: one brief press at the hand-off moment.
      const press = progress(elapsed, SEND_AT - 40, 90) - progress(elapsed, SEND_AT + 50, 160);
      send.style.transform = `scale(${1 - clamp(press) * 0.12})`;
      setOpacity(send, 0.55 + clamp(typeProgress) * 0.45);

      // Question bubble: starts as the composer's exact box, settles into a
      // message on the same centre, and holds there until the answer arrives.
      const shape = easeOut(progress(elapsed, MORPH_AT, MORPH_DURATION));
      const lift = easeOut(progress(elapsed, HANDOVER_AT, BUBBLE_LIFT_DURATION));
      setOpacity(bubble, progress(elapsed, MORPH_AT, 80) * (1 - lift) * fadeOut);
      bubble.style.transform = `translate(${mix(morph.x, 0, shape)}px, ${
        mix(morph.startY, morph.restY, shape) - lift * BUBBLE_LIFT_DISTANCE
      }px) scale(${mix(morph.scaleX, 1, shape)}, ${mix(morph.scaleY, 1, shape)})`;
      setOpacity(bubbleText, clamp((shape - 0.45) / 0.55));

      // Answer bubble: rises into the centre the question bubble is vacating.
      const answerIn = easeOut(progress(elapsed, ANSWER_AT, ANSWER_IN_DURATION));
      setOpacity(answer, answerIn * fadeOut);
      answer.style.transform = `translateY(-50%) translateY(${(1 - answerIn) * 14}px)`;

      const processingActive = elapsed >= PROCESSING_AT && elapsed < PROCESSING_UNTIL;
      setOpacity(processing, processingActive ? 1 : 0);
      dots.forEach((dot, index) => {
        const rise = progress(elapsed, PROCESSING_AT + index * 90, 180);
        const departAt = PROCESSING_UNTIL - 200 + index * 40;
        const depart = elapsed > departAt ? 1 - progress(elapsed, departAt, 120) : 1;
        dot.style.opacity = String(processingActive ? rise * depart : 0);
        dot.style.transform = `translateY(${(1 - rise) * 2}px)`;
      });

      responseGroups.forEach((group, index) => {
        setRise(group, progress(elapsed, RESPONSE_STARTS[index], 450));
      });

      setRise(primary, progress(elapsed, PRIMARY_AT, 300));

      secondary.forEach((item, index) => {
        setRise(item, progress(elapsed, SECONDARY_STARTS[index], 300));
      });
    };

    const stop = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };

    const tick = (now: number) => {
      if (destroyed || !simulator.isConnected) {
        destroy();
        return;
      }
      render((now - startedAt) % DURATION);
      frame = requestAnimationFrame(tick);
    };

    const start = () => {
      stop();
      simulator.dataset.animated = "true";
      measure();
      render(0);
      startedAt = performance.now();
      frame = requestAnimationFrame(tick);
    };

    const applyMotionPreference = () => {
      stop();
      if (motionPreference.matches) {
        delete simulator.dataset.animated;
        simulator.dataset.static = "true";
        renderComplete();
      } else {
        delete simulator.dataset.static;
        measured = false;
        if (visible) start();
        else render(0);
      }
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (motionPreference.matches) {
          renderComplete();
        } else if (visible) {
          start();
        } else {
          stop();
          render(0);
        }
      },
      { threshold: 0.12 },
    );

    // The morph is measured, so any reflow invalidates it.
    const resizeObserver = new ResizeObserver(() => {
      measured = false;
    });

    const destroy = () => {
      if (destroyed) return;
      destroyed = true;
      stop();
      observer.disconnect();
      resizeObserver.disconnect();
      removalObserver.disconnect();
      motionPreference.removeEventListener("change", applyMotionPreference);
    };

    const removalObserver = new MutationObserver(() => {
      if (!simulator.isConnected) destroy();
    });

    observer.observe(simulator);
    resizeObserver.observe(stage);
    removalObserver.observe(document.documentElement, { childList: true, subtree: true });
    motionPreference.addEventListener("change", applyMotionPreference);
    applyMotionPreference();
    simulator.dataset.geoReady = "true";
  });
</script>

<style>
  .geo-simulator {
    width: 100%;
    min-height: 460px;
    color: var(--ink-body);
    font-size: 1rem;
    line-height: 1.52;
  }

  /* Static fallback: the same three blocks, stacked and centred. */
  .geo-simulator__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    align-items: center;
    justify-content: center;
    min-height: 460px;
  }

  .geo-simulator__question,
  .geo-simulator__answer,
  .geo-simulator__composer {
    margin-inline: auto;
  }

  .geo-simulator__question {
    width: fit-content;
    max-width: min(100%, 27rem);
    padding: 18px 24px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 24px;
    transform-origin: 0 0;
  }

  .geo-simulator__answer {
    position: relative;
    width: min(100%, 31rem);
    padding: 26px;
    background: var(--surface-container);
    border-radius: 24px;
  }

  /* Always out of flow, dead centre: it fills the beat between the question
     leaving and the answer arriving, and never affects layout. */
  .geo-simulator__processing {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 8px;
    opacity: 0;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .geo-simulator__processing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--outline);
  }

  .geo-simulator__answer-label {
    margin: 0;
    color: var(--data-gray);
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .geo-simulator__recommendations {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: var(--s4) 0 0;
    list-style: none;
  }

  .geo-simulator__recommendation {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .geo-simulator__recommendation--primary {
    color: var(--ink);
    font-weight: 700;
  }

  .geo-simulator__number {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .geo-simulator__business {
    color: var(--signal-deep);
  }

  .geo-simulator__composer {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    width: min(100%, 31rem);
    padding: 10px 10px 10px 18px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 24px;
  }

  .geo-simulator__field {
    display: grid;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 1.5em;
    padding: 7px 0;
    color: var(--ink-body);
  }

  .geo-simulator__field > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .geo-simulator__placeholder {
    color: var(--data-gray);
  }

  .geo-simulator__cursor {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    background: var(--ink);
    vertical-align: -0.16em;
  }

  .geo-simulator__send {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }

  /* Animated layout: all three boxes share one centre, so the morph and the
     hand-over happen on the spot. */
  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__question,
  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__answer,
  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__composer {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
  }

  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__answer,
  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__composer {
    transform: translateY(-50%);
  }

  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__question {
    z-index: 1;
  }

  :global(html.js) .geo-simulator:not([data-static]) .geo-simulator__composer {
    z-index: 2;
  }

  :global(html.js) .geo-simulator:not([data-geo-ready]) .geo-simulator__question,
  :global(html.js) .geo-simulator:not([data-geo-ready]) .geo-simulator__answer,
  :global(html.js) .geo-simulator:not([data-geo-ready]) .geo-simulator__composer {
    opacity: 0;
  }

  @media (max-width: 720px) {
    .geo-simulator,
    .geo-simulator__stage {
      min-height: 210px;
    }

    .geo-simulator__question {
      max-width: 100%;
      padding: 16px 20px;
    }

    .geo-simulator__answer {
      padding: 22px 20px;
    }

    .geo-simulator__processing {
      top: 26px;
      right: 20px;
      left: 20px;
    }

    .geo-simulator__composer {
      padding-left: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .geo-simulator,
    .geo-simulator *,
    .geo-simulator *::before,
    .geo-simulator *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
