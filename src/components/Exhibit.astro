---
/**
 * An AI answer used as evidence.
 *
 * Two modes.
 *  - `src` supplied → a real, dated screenshot.
 *  - no `src` → a labelled sample layout. It is never dressed up as a real
 *    capture; the caption says exactly what it is.
 *
 * The recommended business is marked with a bordered tag beside the answer,
 * never with an overlay, so nothing can ever sit on top of the text.
 */
interface Props {
  model: string;
  date?: string;
  query: string;
  business: string;
  src?: string;
  alt?: string;
  size?: "lead" | "grid";
  class?: string;
  /** Position in a row of exhibits. Sets the scroll-reveal stagger. */
  index?: number;
}

const { model, date, query, business, src, alt, size = "grid", class: className = "", index } = Astro.props;
const reveal = index !== undefined;
---

<figure
  class={`exhibit exhibit--${size} ${className}`.trim()}
  data-reveal={reveal ? "" : undefined}
  style={reveal ? `--i:${index}` : undefined}
>
  <div class="exhibit-bar">
    <span>{model}</span>
    <span>{date ?? "Capture date required"}</span>
  </div>

  {
    src ? (
      <div class="exhibit-shot">
        <img src={src} alt={alt ?? `${model} answer recommending ${business}`} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="exhibit-body">
        <p class="exhibit-query">{query}</p>
        <span class="skeleton" style="width:96%" />
        <span class="skeleton" style="width:72%" />
        <p class="exhibit-answer">
          <span class="named">{business}</span>
          <span class="named-tag">Recommended</span>
        </p>
        <span class="skeleton" style="width:88%" />
        <span class="skeleton" style="width:54%" />
      </div>
    )
  }

  <figcaption class="exhibit-caption">
    <span>{src ? model : "Sample layout"}</span>
    <span>{src ? date : "Replace with a real, dated capture"}</span>
  </figcaption>
</figure>
