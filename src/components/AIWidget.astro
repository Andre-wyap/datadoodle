---
/**
 * A real AI-answer evidence card: the label, the query that was asked, the
 * model's answer with the recommended business marked, its status, and the
 * points backing it up — plus the source note that dates the observation.
 *
 * Unlike <Exhibit>, this never renders a skeleton or a screenshot inline.
 * If `screenshot` is supplied, a text control opens it enlarged in the
 * lightbox; the card itself stays typographic so nothing here imitates
 * ChatGPT's or Google's own interface.
 */
interface Screenshot {
  src: string;
  alt: string;
}

interface Props {
  label: string;
  query: string;
  answer: string;
  business: string;
  status: string;
  points: string[];
  note?: string;
  source: string;
  screenshot?: Screenshot;
  /** Position in a row of widgets. Sets the scroll-reveal stagger. */
  index?: number;
}

const { label, query, answer, business, status, points, note, source, screenshot, index } = Astro.props;
const reveal = index !== undefined;

const splitAt = answer.indexOf(business);
const before = splitAt >= 0 ? answer.slice(0, splitAt) : answer;
const after = splitAt >= 0 ? answer.slice(splitAt + business.length) : "";
---

<figure class="ai-widget" data-reveal={reveal ? "" : undefined} style={reveal ? `--i:${index}` : undefined}>
  <div class="ai-widget-bar">
    <span>{label}</span>
    {
      screenshot && (
        <button type="button" class="ai-widget-expand" data-widget-expand data-src={screenshot.src} data-alt={screenshot.alt}>
          View screenshot
        </button>
      )
    }
  </div>

  <div class="ai-widget-body">
    <p class="ai-widget-query">“{query}”</p>
    <p class="ai-widget-answer">
      {before}
      <strong class="named">{business}</strong>
      {after}
    </p>
    <span class="ai-widget-status">{status}</span>

    <ul class="ai-widget-points">
      {points.map((point) => <li>{point}</li>)}
    </ul>

    {note && <p class="ai-widget-note">{note}</p>}
  </div>

  <figcaption class="ai-widget-source">{source}</figcaption>
</figure>
