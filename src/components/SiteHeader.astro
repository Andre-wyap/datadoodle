---
import { Image } from "astro:assets";
import logoLockup from "../assets/logo-lockup.png";

const navLinks: [string, string][] = [
  ["/", "Home"],
  ["/about", "About"],
  ["/case-study", "Case Study"],
  ["/blog", "Blog"],
  ["/contact", "Contact"],
];
---

<header class="site-header" data-header>
  <div class="shell">
    <a class="brand" href="/" aria-label="DataDoodles home">
      <Image src={logoLockup} alt="DataDoodles" width={278} height={52} loading="eager" />
    </a>

    <nav class="site-nav" aria-label="Sections">
      <ul>
        {navLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    <a class="header-action" href="/#visibility-check">
      Get your quote <span aria-hidden="true">→</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="sr-only" data-nav-toggle-label>Open menu</span>
    </button>
  </div>

  <div class="nav-panel" id="nav-panel" data-nav-panel>
    <nav class="shell" aria-label="Sections menu">
      <ul>
        {navLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
      <a class="nav-panel-cta" href="/#visibility-check">Get your quote</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const navToggle = document.querySelector("[data-nav-toggle]");
  const navPanel = document.querySelector("[data-nav-panel]");
  const navToggleLabel = document.querySelector("[data-nav-toggle-label]");

  if (header && navToggle instanceof HTMLButtonElement && navPanel) {
    const setMenu = (open: boolean) => {
      header.classList.toggle("nav-open", open);
      navToggle.setAttribute("aria-expanded", String(open));
      if (navToggleLabel) navToggleLabel.textContent = open ? "Close menu" : "Open menu";
    };

    navToggle.addEventListener("click", () => setMenu(navToggle.getAttribute("aria-expanded") !== "true"));

    navPanel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) setMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || navToggle.getAttribute("aria-expanded") !== "true") return;
      setMenu(false);
      navToggle.focus();
    });

    document.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Element && !event.target.closest(".site-header")) setMenu(false);
    });

    const wide = window.matchMedia("(min-width: 1081px)");
    wide.addEventListener("change", (event) => {
      if (event.matches) setMenu(false);
    });
  }
</script>
